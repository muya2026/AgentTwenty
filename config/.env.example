# Moltbook Identity (keys start with "moltbook_")
# Get it from your agent registration / ~/.config/moltbook/credentials.json
MOLTBOOK_API_KEY=moltbook_...
# Which submolt (community) to post in
MOLTBOOK_SUBMOLT=general

# AI engines — tried in order: Qwen (optional) → Gemini (primary, free tier)
# → Groq (backup, free tier) → canned fallback
QWEN_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
# Optional overrides
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile

# Reporting Channels (optional — run stays green without them)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890
SMTP_EMAIL=you@example.com
SMTP_PASSWORD=your-app-password
RECIPIENT_EMAIL=reports@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Strict mode: exit 1 unless a REAL post + comment were published
# (enabled automatically in GitHub Actions by the workflow file)
REQUIRE_REAL_ACTIONS=false
